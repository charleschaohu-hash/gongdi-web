.seg { display: flex; background: #EFEDE6; border-radius: 14rpx; padding: 4rpx; margin-bottom: 18rpx; }
.seg-item { flex: 1; text-align: center; font-size: 26rpx; padding: 10rpx 0; border-radius: 11rpx; color: #55535E; }
.seg-item.on { background: #FFFFFF; color: #534AB7; font-weight: 600; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06); }
.mrow { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #F0EEE6; }
.mrow.head { border-bottom: none; padding: 0 0 6rpx; }
.mrow:last-of-type { border-bottom: none; }
.mname { width: 168rpx; font-size: 24rpx; flex-shrink: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mcell { flex: 1; display: flex; justify-content: center; align-items: center; }
.mcol { font-size: 20rpx; color: #8C8A94; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; border: 2rpx solid #C9C6BC; background: transparent; box-sizing: border-box; }
.dot.done { width: 20rpx; height: 20rpx; background: #5DCAA5; border-color: #5DCAA5; }
.dot.current { width: 26rpx; height: 26rpx; background: #EEEDFE; border: 3rpx solid #7F77DD; }
.dot.parallel { width: 24rpx; height: 24rpx; background: #EEEDFE; border: 3rpx solid #7F77DD; opacity: 0.55; }
.dot.wait { width: 26rpx; height: 26rpx; background: #FAEEDA; border: 3rpx solid #EF9F27; }
.dot.inline { display: inline-block; vertical-align: middle; margin-right: 6rpx; }
.legend { display: flex; gap: 20rpx; flex-wrap: wrap; padding: 14rpx 0 4rpx; }
