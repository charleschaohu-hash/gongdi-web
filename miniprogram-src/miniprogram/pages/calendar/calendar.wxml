<view class="page">
  <view class="row" style="margin-bottom:14rpx;">
    <text class="chip sm" bindtap="prev">‹ 上月</text>
    <text class="title" style="text-align:center;">{{title}}</text>
    <text class="chip sm" bindtap="next">下月 ›</text>
  </view>
  <scroll-view wx:if="{{chips.length}}" scroll-x style="white-space:nowrap; margin-bottom:10rpx;">
    <text class="chip sm" style="margin-right:10rpx; {{!filtered ? 'background:#EEEDFE;color:#3C3489;border-color:#7F77DD;' : ''}}" bindtap="tapChip" data-id="all">全部</text>
    <text class="chip sm" style="margin-right:10rpx; {{item.on ? 'background:#EEEDFE;color:#3C3489;border-color:#7F77DD;' : ''}}"
          wx:for="{{chips}}" wx:key="id" bindtap="tapChip" data-id="{{item.id}}">{{item.on ? '✓ ' : ''}}{{item.name}}</text>
  </scroll-view>
  <view class="grid head">
    <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
  </view>
  <view class="grid">
    <view class="cell" wx:for="{{cells}}" wx:key="idx" bindtap="tapDay" data-ds="{{item.ds}}">
      <view wx:if="{{!item.blank}}" class="daynum {{item.sel ? 'sel' : ''}} {{item.isToday && !item.sel ? 'today' : ''}}">{{item.d}}</view>
      <view class="dots">
        <view class="dotc" wx:for="{{item.dots}}" wx:for-item="c" wx:key="k" style="background:{{c.c}};"></view>
      </view>
    </view>
  </view>
  <view class="row legend muted">
    <text><text class="dotc" style="background:#5DCAA5;"></text> 完成</text>
    <text><text class="dotc" style="background:#7F77DD;"></text> 计划</text>
    <text><text class="dotc" style="background:#EF9F27;"></text> 今日</text>
    <text><text class="dotc" style="background:#E24B4A;"></text> 逾期</text>
  </view>
  <view class="sec">{{selTxt}}</view>
  <view wx:if="{{!list.length}}" class="muted small" style="margin:0 4rpx;">这天没有任务</view>
  <view class="trow" wx:for="{{list}}" wx:key="id" bindtap="tapTask" data-id="{{item.id}}">
    <view class="grow">
      <text class="tname {{item.st === 'done' ? 'done' : ''}}">{{item.name}}</text>
      <text class="muted small" style="display:block;">{{item.m}}</text>
      <text wx:if="{{item.desc}}" class="desc">{{item.desc}}</text>
    </view>
    <text class="badge {{item.stTxt === '已完成' ? 'ok' : (item.stTxt === '已逾期' ? 'warn' : 'purple')}}">{{item.stTxt}}</text>
  </view>
</view>
